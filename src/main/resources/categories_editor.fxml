<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sst.bank.editor.CategoriesEditorController"
            style="-fx-font-size: 11;">
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Select Category:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="categoryComboBox" prefWidth="300"/>
                <Button fx:id="createCategoryButton" text="➕ New Category" style="-fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5" style="-fx-padding: 10;">
            <!-- Left panel: Category details -->
            <ScrollPane fitToWidth="true" style="-fx-border-color: #cccccc; -fx-border-width: 1;">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <!-- Basic Information -->
                    <TitledPane text="Category Information" collapsible="false">
                        <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <!-- Category Name -->
                            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   style="-fx-font-weight: bold;"/>
                            <TextField fx:id="categoryNameTextField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <!-- Priority -->
                            <Label text="Priority:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   style="-fx-font-weight: bold;"/>
                            <TextField fx:id="priorityTextField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <!-- Flags -->
                            <Label text="Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                   style="-fx-font-weight: bold;"/>
                            <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <CheckBox fx:id="incomeCheckBox" text="Income"/>
                                <CheckBox fx:id="savingCheckBox" text="Savings"/>
                            </HBox>

                            <!-- Update/Delete buttons -->
                            <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                <Button fx:id="updateCategoryButton" text="✏️ Update Category" style="-fx-font-size: 11;"/>
                                <Button fx:id="deleteCategoryButton" text="🗑️ Delete Category" style="-fx-font-size: 11;"/>
                            </HBox>
                        </GridPane>
                    </TitledPane>

                    <!-- Budget Section -->
                    <TitledPane text="Monthly Budget" collapsible="false">
                        <ScrollPane fitToWidth="true" style="-fx-padding: 5;">
                            <VBox fx:id="budgetVBox" spacing="5" style="-fx-padding: 5;"/>
                        </ScrollPane>
                    </TitledPane>
                </VBox>
            </ScrollPane>

            <!-- Right panel: Criteria management -->
            <ScrollPane fitToWidth="true" style="-fx-border-color: #cccccc; -fx-border-width: 1;">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TitledPane text="Criteria Management" collapsible="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <!-- Criteria List -->
                            <Label text="Criteria List:" style="-fx-font-weight: bold;"/>
                            <ListView fx:id="criteriaListView" prefHeight="300"/>
                            <Button fx:id="removeCriteriaButton" text="🗑️ Remove Selected Criteria" style="-fx-font-size: 11;"/>

                            <Separator/>

                            <!-- Add new criteria -->
                            <Label text="Add New Criteria:" style="-fx-font-weight: bold;"/>

                            <GridPane hgap="10" vgap="10" style="-fx-padding: 5;">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <!-- Criteria value -->
                                <Label text="Value:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <TextField fx:id="criteriaSearchTextField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           promptText="e.g., account number or transaction detail"/>

                                <!-- Criteria field type -->
                                <Label text="Field:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="criteriaFieldComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                          prefWidth="300"/>

                                <!-- Optional comment -->
                                <Label text="Comment:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <TextField fx:id="criteriaCommentTextField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                           promptText="(optional) e.g., bank name"/>

                                <!-- Add button -->
                                <Button fx:id="addCriteriaButton" text="➕ Add Criteria" style="-fx-font-size: 11;"
                                        GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                            </GridPane>
                        </VBox>
                    </TitledPane>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
            <Button fx:id="saveCategoriesButton" text="💾 Save Categories to File" prefWidth="200"
                    style="-fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10;"/>
        </HBox>
    </bottom>
</BorderPane>
